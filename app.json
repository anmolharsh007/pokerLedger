{
  "expo": {
    "name": "poker-ledger",
    "slug": "poker-ledger",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "pokerledger",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anmolharsh.pokerledger",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "com.anmolharsh.pokerledger",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Used to scan a table-claim QR code someone hands you.",
          "barcodeScannerEnabled": true
        }
      ],
      "expo-font",
      "expo-splash-screen",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.339157808585-ucko76u339b2d33p8rlvqtko8902pn8d"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e39db4e6-3da2-4ab2-8f3e-886d8ac22044"
      }
    },
    "owner": "pooki_gabbar"
  }
}
