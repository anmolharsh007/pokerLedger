# Google Sign-In OAuth client ID(s) for THIS project — a separate
# OAuth client from sheet-ui's, even though it can live in the same
# Google Cloud project (APIs/consent screen already set up there).
# Only the one(s) for platforms you actually build are required.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Required alongside EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID only — Google's
# token endpoint requires a client_secret for "Web application" type
# clients even with PKCE. Not needed for iOS/Android client types.
# NOTE: since this app has no backend server, this ships inside the
# client bundle and is not actually confidential.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_SECRET=

# Firebase project config (lib/firebase.ts) — backs the cross-table
# discovery index (lib/accountsApi.ts): email -> which tables a person
# is in, so someone sees every table they're a player in the moment
# they sign in, regardless of who created it. A normal client-side
# Firebase config — not a secret; access is governed by Firestore
# rules (firestore.rules), not by keeping this hidden.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
